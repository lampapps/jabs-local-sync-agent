# JABS Local Sync Agent Environment Variables
# Copy this file to '.env' and fill in your values. '.env' is gitignored and
# will never be committed.

# This will enable debug logging.
# Uncomment the following line if codebase is in development mode
# ENV_MODE='development'

# URL:PORT for the JABS Dashboard.
JABS_DASHBOARD_URL="http://your-jabs-dashboard:5000"

# API key for this agent, generated on the dashboard's Agents page (Regenerate
# there if this ever needs to be rotated).
JABS_AGENT_KEY=""

# Path to the rsync binary. Leave unset/empty to use "rsync" from PATH
# (covers apt/dnf/pacman/Homebrew installs). Only set this to an absolute
# path if rsync was installed somewhere NOT on PATH, e.g.:
# RSYNC_BIN="/opt/rsync/bin/rsync"
RSYNC_BIN=""

# SMTP credentials (for immediate failure/completion email notifications,
# see config/global.yaml's email.notify_on section)
JABS_SMTP_USERNAME=""
JABS_SMTP_PASSWORD=""
